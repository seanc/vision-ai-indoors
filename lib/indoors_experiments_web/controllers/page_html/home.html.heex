<Layouts.app flash={@flash}>
  <%!--
    Everything on this page is driven by assets/js/vision/index.js.
    The ids below are how the JS finds each element.
  --%>
  <div id="vision-app" class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
    <section class="space-y-4">
      <%!-- The stage: live video with the overlay canvas stretched over it. --%>
      <div class="relative overflow-hidden rounded-2xl bg-black shadow-2xl shadow-black/50 ring-1 ring-white/10">
        <video id="video" class="block aspect-video w-full object-contain" playsinline muted>
        </video>
        <canvas
          id="overlay"
          class="pointer-events-none absolute inset-0 h-full w-full object-contain"
        >
        </canvas>

        <div
          id="stage-empty"
          class="absolute inset-0 grid place-items-center bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.08),transparent_60%)]"
        >
          <div class="max-w-sm space-y-2 px-6 text-center">
            <.icon name="hero-video-camera" class="size-10 text-slate-600" />
            <p class="text-sm font-medium text-slate-300">Point a camera down a hallway</p>
            <p class="text-xs leading-relaxed text-slate-500">
              Line the far end up with where the guide lines cross, then walk towards it.
              No camera handy? Load a video file instead.
            </p>
          </div>
        </div>
      </div>

      <%!-- Controls --%>
      <div class="flex flex-wrap items-center gap-3">
        <button
          id="start-camera"
          type="button"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-400 px-4 py-2.5 text-sm font-semibold text-[#06120d] shadow-lg shadow-emerald-500/20 transition hover:-translate-y-0.5 hover:bg-emerald-300 active:translate-y-0"
        >
          <.icon name="hero-video-camera-mini" class="size-4" /> Start camera
        </button>

        <label
          for="video-file"
          class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-200 ring-1 ring-white/10 transition hover:-translate-y-0.5 hover:bg-white/10"
        >
          <.icon name="hero-film-mini" class="size-4" /> Use a video file
          <input id="video-file" type="file" accept="video/*" class="sr-only" />
        </label>

        <button
          id="stop"
          type="button"
          disabled
          class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium text-slate-400 ring-1 ring-white/10 transition hover:text-slate-200 disabled:cursor-not-allowed disabled:opacity-40"
        >
          <.icon name="hero-stop-mini" class="size-4" /> Stop
        </button>

        <label class="ml-auto flex items-center gap-2 text-xs text-slate-400">
          Target fps
          <select
            id="fps-select"
            class="rounded-lg border-0 bg-white/5 py-1.5 pr-8 pl-3 text-sm text-slate-200 ring-1 ring-white/10 focus:ring-emerald-400/60"
          >
            <option value="2">2</option>
            <option value="5">5</option>
            <option value="8" selected>8</option>
            <option value="12">12</option>
          </select>
        </label>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2">
        <p
          id="status"
          class="text-xs text-slate-500 data-[ok=false]:text-rose-300 data-[ok=true]:text-emerald-300"
        >
          Connecting…
        </p>
        <p id="level" class="text-xs text-slate-500"></p>
      </div>
    </section>

    <aside class="space-y-4">
      <%!-- Decision --%>
      <div
        id="decision"
        data-level="clear"
        class="rounded-2xl bg-emerald-500/15 p-5 text-emerald-300 ring-1 ring-emerald-400/40 transition-colors duration-300"
      >
        <p class="text-[11px] font-semibold tracking-[0.2em] uppercase opacity-70">Decision</p>
        <p id="decision-level" class="mt-1 text-4xl font-black tracking-tight">CLEAR</p>
        <p id="decision-reason" class="mt-2 min-h-10 text-sm text-slate-300">
          Nothing in the way
        </p>
        <div class="mt-4 h-1 overflow-hidden rounded-full bg-white/10" title="Confidence">
          <div
            id="decision-confidence"
            class="h-full w-0 rounded-full bg-current transition-[width] duration-300"
          >
          </div>
        </div>
      </div>

      <%!-- Numbers --%>
      <div class="rounded-2xl bg-white/[0.03] p-5 ring-1 ring-white/10">
        <p class="text-[11px] font-semibold tracking-[0.2em] text-slate-500 uppercase">Latency</p>
        <dl class="mt-3 grid grid-cols-3 gap-y-3 text-sm">
          <.stat id="stat-fps" label="fps" />
          <.stat id="stat-round-trip" label="round trip" />
          <.stat id="stat-server" label="server" />
          <.stat id="stat-model" label="model" />
          <.stat id="stat-size" label="frame size" />
          <.stat id="stat-frame" label="frame" />
        </dl>

        <%!-- Where each frame's time goes. Widths are set by renderTimeline() in index.js. --%>
        <div id="latency-bar" class="mt-4 flex h-2 overflow-hidden rounded-full bg-white/5">
          <span
            :for={{segment, colour} <- latency_segments()}
            data-segment={segment}
            class={["h-full w-0 transition-[width] duration-300", colour]}
          >
          </span>
        </div>
        <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-slate-500">
          <li :for={{segment, colour} <- latency_segments()} class="flex items-center gap-1">
            <span class={["size-2 rounded-full", colour]}></span>{segment}
          </li>
        </ul>
      </div>

      <%!-- Tracks --%>
      <div class="rounded-2xl bg-white/[0.03] p-5 ring-1 ring-white/10">
        <p class="text-[11px] font-semibold tracking-[0.2em] text-slate-500 uppercase">Tracks</p>
        <p id="track-list-empty" class="mt-3 text-sm text-slate-500">Nothing tracked yet.</p>
        <ul id="track-list" class="mt-3 space-y-2 text-sm"></ul>
      </div>

      <%!-- Legend --%>
      <ul class="grid grid-cols-3 gap-2 text-[11px] text-slate-400">
        <li class="flex items-center gap-1.5">
          <span class="size-2.5 rounded-sm bg-emerald-400"></span> my half
        </li>
        <li class="flex items-center gap-1.5">
          <span class="size-2.5 rounded-sm bg-amber-400"></span> oncoming
        </li>
        <li class="flex items-center gap-1.5">
          <span class="size-2.5 rounded-sm bg-slate-400"></span> off path
        </li>
      </ul>
    </aside>

    <%!-- Hidden: frames are drawn here to be encoded as JPEG. --%>
    <canvas id="capture-canvas" class="hidden"></canvas>
  </div>
</Layouts.app>
